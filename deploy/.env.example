# Copy to .env and fill in. Never commit .env.

# --- Your public addresses (no https://) -------------------------------------------------------
# With a domain:  SITE_DOMAIN=stallo.com   API_DOMAIN=api.stallo.com   (both A records -> the server's IP)
# No domain yet:  use sslip.io, which turns the server's IP into a name. For IP 13.250.10.20 (dots to dashes):
SITE_DOMAIN=13-250-10-20.sslip.io
API_DOMAIN=api.13-250-10-20.sslip.io

# --- Secrets -------------------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
DJANGO_SECRET_KEY=

# Admin login, created on the first start only (changing these later does not change the account).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# --- Optional ------------------------------------------------------------------------------------
# DELIVERY_FEE=80
# PICKUP_LEAD_MINUTES=30
# PICKUP_DAYS_AHEAD=7
# ORDER_THROTTLE_RATE=30/hour
# AUTH_THROTTLE_RATE=30/hour
# NEXT_PUBLIC_ACCOUNTS_ENABLED=true

# --- Product pictures (S3) --------------------------------------------------------------------
# Pictures uploaded in admin are stored in this S3 bucket (see DEPLOY.md, "Product pictures"). The server
# reaches it through its IAM role, so there are no keys to put here. Leave empty to keep pictures on the
# server's disk instead (they would then be lost if the server is rebuilt).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1
# AWS_S3_CUSTOM_DOMAIN=            # only if you put CloudFront in front of the bucket

# Backups (backup.sh): also copy each backup to this S3 bucket (needs the server to have an IAM role for it).
# BACKUP_S3_BUCKET=my-stallo-backups
