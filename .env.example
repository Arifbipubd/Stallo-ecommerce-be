DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
ORDER_THROTTLE_RATE=30/hour
AUTH_THROTTLE_RATE=30/hour
DELIVERY_FEE=80
PICKUP_LEAD_MINUTES=30

# Product pictures: leave empty to save uploads on this machine (media/ folder). Set a bucket to use S3.
# AWS_STORAGE_BUCKET_NAME=my-stallo-media
# AWS_S3_REGION_NAME=ap-southeast-1
# AWS_ACCESS_KEY_ID=...        # not needed on an EC2 server with an IAM role
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com   # optional: CloudFront in front of the bucket

# Docker only: create an admin login on start (skipped if it already exists).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-one
# Behind HTTPS on another origin: CSRF_TRUSTED_ORIGINS=https://api.example.com
